{
  "name": "kids-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Browser game platform for kids, driven by a USB steering wheel. Three.js + TypeScript + Vite.",
  "scripts": {
    "audit:world": "npx tsx tools/audit-world.ts",
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tools && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "plan-hash": "npx tsx tools/plan-hash.ts",
    "bundle": "node tools/pack.mjs",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
